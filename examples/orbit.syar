syar 1;
use std;
// An exact four-second procedural loop, with independent frame evaluation.
param duration: float = 4.0;
let phase = loop(t, duration);
let angle = phase * tau;
let center = vec2(0.5, 0.5) + vec2(cos(angle), sin(angle)) * 0.22;
let disc = circle(p - center, radius: 0.12);
let halo = glow(disc, radius: 0.06, color: srgb("#386bff99"));
let ball = fill(disc, srgb("#ffca69"));
output main = over(ball, over(halo, srgb("#091426")));
