syar 1;
// Heighway dragon: the paperfolding turn sequence drives a mathematical turtle.
// The turn at index n follows its odd part modulo four. No stored point array.
// main unfolds from t=0; choose still for the complete finite-generation curve.
viewbox(-0.45, -0.8, 1.75, 1.3);
param depth: int = 10;
param draw_seconds: float = 12.0;
param line_width: float = 0.0022;
param ember: color = srgb("#ff9378");
param violet: color = srgb("#a58aff");
param paper: color = srgb("#0c0b19");

fn segment_distance(q: vec2, a: vec2, b: vec2) -> float {
    let d = b-a;
    return length(q-a-d*clamp(dot(q-a,d)/max(dot(d,d),0.0000000001),0.0,1.0));
}
fn dragon(q: vec2, progress: float) -> color {
    let generation = int(clamp(float(depth),0.0,10.0));
    let count = int(pow(2.0,float(generation)));
    let step_length = pow(0.5,float(generation)*0.5);
    // Undo the endpoint's generation-dependent rotation to preserve composition.
    let angle = -float(generation)*pi/4.0;
    var direction = vec2(cos(angle),sin(angle));
    var position = vec2(0,0);
    let visible = clamp(progress,0.0,1.0)*float(count);
    var nearest = 100.0;
    var phase = 0.0;
    for index in 0..1024 {
        if float(index)>=visible {break;}
        let next = position+direction*step_length;
        let endpoint = mix(position,next,clamp(visible-float(index),0.0,1.0));
        let distance = segment_distance(q,position,endpoint);
        if distance<nearest {nearest=distance;phase=float(index)/float(count);}
        position = next;
        var odd = index+1;
        for bit in 0..10 {
            if odd%2!=0 {break;}
            odd = int(float(odd)/2.0);
        }
        if odd%4==1 {direction=vec2(-y(direction),x(direction));}
        else {direction=vec2(y(direction),-x(direction));}
    }
    let width = max(abs(line_width),pixel_size()*0.65);
    let core = 1.0-smoothstep(width*0.45,width*1.4,nearest);
    let halo = exp(-nearest/max(width*4.0,0.00001))*0.25;
    let color = mix(ember,violet,phase);
    return over(opacity(color,clamp(core+halo,0.0,1.0)),paper);
}
output main = dragon(p,t/max(draw_seconds,0.01));
output still = dragon(p,1.0);
